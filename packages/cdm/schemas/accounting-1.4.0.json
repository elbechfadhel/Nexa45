    "status": {
      "$ref": "#/$defs/DocumentStatus"
    },
    "number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Number"
    },
    "reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    },
    "accounting_date": {
      "format": "date",
      "title": "Accounting Date",
      "type": "string"
    },
    "document_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Date"
    },
    "due_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due Date"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "partner": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartnerRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "total_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Total Amount"
    },
    "tax_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Tax Amount"
    },
    "lines": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    }
  },
  "required": [
    "source_ref",
    "document_type",
    "status",
    "accounting_date",
    "currency",
    "total_amount",
    "tax_amount"
  ],
  "title": "AccountingDocument",
  "type": "object",
  "$id": "https://go45.io/uie/cdm/accounting-1.4.0.json"
}
