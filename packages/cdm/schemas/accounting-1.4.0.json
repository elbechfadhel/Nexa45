        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/LedgerAccountRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "gross_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gross Amount"
        },
        "taxes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TaxRef"
          },
          "title": "Taxes",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/PostingCategoryRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tax_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Rate"
        },
        "tax_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax Amount"
        },
        "supply_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupplyKind"
            },
            {
              "type": "null"
            }
