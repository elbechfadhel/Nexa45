      "required": [
        "kind",
        "amount"
      ],
      "title": "DocumentLine",
      "type": "object"
    },
    "DocumentStatus": {
      "enum": [
        "POSTED",
        "DRAFT",
        "CANCELLED"
      ],
      "title": "DocumentStatus",
      "type": "string"
    },
    "DocumentType": {
      "enum": [
        "CUSTOMER_INVOICE",
        "CUSTOMER_CREDIT_NOTE",
        "VENDOR_BILL",
        "VENDOR_CREDIT_NOTE",
        "CASH_RECEIPT",
        "CASH_PAYMENT",
        "BANK_RECEIPT",
        "BANK_PAYMENT"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "LedgerAccountRef": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "source_ref",
        "code"
      ],
      "title": "LedgerAccountRef",
      "type": "object"
    },
    "LineKind": {
      "enum": [
        "ITEM",
        "TAX",
        "OPEN_ITEM",
        "ROUNDING"
      ],
      "title": "LineKind",
      "type": "string"
    },
    "PartnerRef": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PartnerRole"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "role",
        "name"
      ],
      "title": "PartnerRef",
      "type": "object"
    },
    "PartnerRole": {
      "enum": [
        "CUSTOMER",
        "SUPPLIER"
      ],
      "title": "PartnerRole",
      "type": "string"
    },
    "PostingCategoryRef": {
      "additionalProperties": false,
      "description": "Catégorie de comptabilisation de la SOURCE (1.1.0) : classe une ligne sans être un compte.",
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "source_ref"
      ],
      "title": "PostingCategoryRef",
      "type": "object"
    },
    "SettlementRef": {
      "additionalProperties": false,
      "description": "Facture réglée par un paiement (1.4.0) : référence opaque de la pièce et son numéro (lettrage).",
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "number": {
          "minLength": 1,
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "number"
      ],
      "title": "SettlementRef",
      "type": "object"
    },
    "SupplyKind": {
      "description": "Nature d'une opération (1.2.0) : livraison de marchandises ou prestation de service.",
      "enum": [
        "GOODS",
        "SERVICES"
      ],
      "title": "SupplyKind",
      "type": "string"
    },
    "TaxComputation": {
      "enum": [
        "PERCENT",
        "FIXED",
        "GROUP"
      ],
      "title": "TaxComputation",
      "type": "string"
    },
    "TaxRef": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "computation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxComputation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaxScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
