        "price_included": {
          "default": false,
          "title": "Price Included",
          "type": "boolean"
        }
      },
      "required": [
        "source_ref",
        "name"
      ],
      "title": "TaxRef",
      "type": "object"
    },
    "TaxScope": {
      "enum": [
        "SALE",
        "PURCHASE",
        "NONE"
      ],
      "title": "TaxScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model_version": {
      "default": "1.4.0",
      "title": "Model Version",
      "type": "string"
    },
    "source_ref": {
      "minLength": 1,
      "title": "Source Ref",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/DocumentType"
