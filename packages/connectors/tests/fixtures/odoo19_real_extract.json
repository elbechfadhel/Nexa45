  {
   "id": 520,
   "model": "account.invoice.report",
   "name": "Invoices Statistics",
   "transient": false,
   "abstract": false,
   "modules": "account, sale",
   "info": " Main super-class for regular database-persisted Odoo models.\n\n    Odoo models are created by inheriting from this class::\n\n        class ResUsers(Model):\n            ...\n\n    The system will later instantiate the class once per database (on\n    which the class' module is installed).\n    ",
   "state": "base",
   "order": "invoice_date desc"
  },
