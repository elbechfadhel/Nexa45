# Connexion PostgreSQL du System Knowledge Registry
UIE_DATABASE_URL=postgresql+psycopg://uie:uie@localhost:5433/uie

# Clé Fernet des secrets d'instance : uv run uie secret gen-key
# UIE_SECRET_KEY=

# Proposition sémantique par LLM (Product Domain V1c, « Ask AI ») — facultatif : sans ces variables, le
# produit fonctionne sans LLM. UIE_LLM_PROVIDER est l'interrupteur explicite (une clé seule n'active rien).
# Seules des MÉTADONNÉES de champs sont envoyées (jamais de valeur métier, de secret ni de nom d'instance).
# UIE_LLM_PROVIDER=openai            # none | openai | anthropic | replay
# OPENAI_API_KEY=                    # ou UIE_OPENAI_API_KEY (prioritaire)
# OPENAI_MODEL=                      # ou UIE_LLM_MODEL (prioritaire) ; obligatoire pour openai
# UIE_ANTHROPIC_API_KEY=             # ou ANTHROPIC_API_KEY ; modèle par défaut claude-opus-5
# UIE_LLM_REPLAY_FILE=domain-packs/catalog/llm/replay/customer17_v1c.json   # démo hors-ligne (replay)
# UIE_LLM_TIMEOUT=30                 # secondes, par champ
# UIE_LLM_PRICE_INPUT= / UIE_LLM_PRICE_OUTPUT=   # USD par million de tokens (coût estimé)
# UIE_LLM_COLUMNS_MODEL=             # colonnes du Wizard ; défaut openai : gpt-4.1-mini

# --- Comptes et sessions (V1d) ---
# Administrateur plateforme initial : `uie admin bootstrap` (idempotent ; la migration ne crée aucun compte).
# Mot de passe : ici, ou saisie masquée si absent (au moins 12 caractères). Ne jamais commiter de vraie valeur.
UIE_INITIAL_ADMIN_EMAIL=admin@go45.local
# UIE_INITIAL_ADMIN_PASSWORD=
# `uie user create` : mot de passe initial (sinon --password-stdin ou saisie masquée ; jamais en argument)
# UIE_USER_PASSWORD=
# Durée d'une session de connexion (heures, défaut 12) ; UIE_ENV=prod → cookie Secure (HTTPS)
# UIE_SESSION_TTL_HOURS=12
# UIE_ENV=dev

# --- Connexion d'un système par un fournisseur (V2b.1) ---
# Le serveur UIE se connecte à l'URL saisie par le fournisseur : les adresses internes (localhost, réseaux
# privés) sont refusées. En développement seulement (instance Odoo locale) : true.
# UIE_ALLOW_PRIVATE_ENDPOINTS=false

# Fichiers catalogue déposés par les fournisseurs (V2c.1) : hors PostgreSQL, ignorés par git
# UIE_IMPORT_DIR=var/imports
